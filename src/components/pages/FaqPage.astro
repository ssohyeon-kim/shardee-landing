---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqGroup from '../faq/FaqGroup.astro';
import { faqIntroduction as koreanIntroduction, faqNotices as koreanNotices } from '../../content/faq';
import { getFaq } from '../../lib/content';
import { localizedPath, t, type Locale } from '../../i18n';
import Breadcrumbs from '../shared/Breadcrumbs.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = t(locale);
const { items: faqItems, categories: faqCategories, introduction: faqIntroduction, notices: faqNotices } = getFaq(locale);
import { site } from '../../config/site';
---
<BaseLayout
  title={ui.meta.faqTitle}
  description={ui.meta.faqDescription}
  canonicalPath={localizedPath(locale, 'faq')} locale={locale} page="faq" questions={faqItems}
>
  <div class="faq-page container">
    <Breadcrumbs locale={locale} label={ui.nav.faq} />
    <header class="faq-header">
      <p class="eyebrow">SHARDEE · HELP</p>
      <h1>{ui.faq.title}</h1>
      <p class="lead">{ui.faq.lead}</p>
    </header>
    <section class="introduction" aria-labelledby="about-shardee">
      <h2 id="about-shardee">{faqIntroduction[0].text}</h2>
      <p>{faqIntroduction[1].text}</p>
      {locale === 'ko' && <details class="english-intro" lang="en">
        <summary>{koreanIntroduction[2].text}</summary>
        <p>{koreanIntroduction[3].text}</p>
      </details>}
    </section>
    <aside class="notices" aria-labelledby="notices-title">
      <h2 id="notices-title">{ui.faq.notices}</h2>
      <ul>{faqNotices.slice(0, 2).map((notice) => <li>{notice}</li>)}</ul>
      {locale === 'ko' && <details lang="en"><summary>Notices in English</summary><ul>{koreanNotices.slice(2).map((notice) => <li>{notice}</li>)}</ul></details>}
    </aside>
    <nav class="category-links" aria-label={ui.faq.categories}>
      {faqCategories.map((category, i) => <a href={`#category-${i + 1}`}>{category}</a>)}
    </nav>
    <div class="faq-list" aria-label={ui.faq.all}>
      {faqCategories.map((category, i) => <FaqGroup id={`category-${i + 1}`} category={category} items={faqItems.filter((item) => item.category === category)} />)}
    </div>
    <section class="contact" aria-labelledby="contact-title">
      <p class="eyebrow">LET’S TALK</p>
      <h2 id="contact-title">{ui.faq.contactTitle}</h2>
      <p>{ui.faq.contactDescription}</p>
      <a href={`mailto:${site.email}`}>{site.email} ↗</a>
    </section>
  </div>
</BaseLayout>
<style>
  .faq-page { padding-block: clamp(4rem, 9vw, 7rem) 6rem; max-width: 1100px; }
  .eyebrow { color: var(--color-muted); font-size: .8rem; letter-spacing: .13em; margin: 0 0 1.25rem; }
  h1 { font-size: clamp(2.1rem, 6vw, 4rem); line-height: 1.2; letter-spacing: -.05em; margin: 0; }
  .lead { color: var(--color-muted); font-size: 1.1rem; line-height: 1.8; margin-block: 1.5rem; }
  .introduction { margin-top: 4rem; max-width: 760px; }
  .introduction h2, .notices h2 { font-size: 1.2rem; letter-spacing: -.025em; }
  .introduction p, .notices { line-height: 1.85; }
  .english-intro { margin-top: 1rem; color: var(--color-muted); }
  .english-intro summary, .notices summary { cursor: pointer; min-height: 44px; padding-block: .5rem; }
  .notices { background: color-mix(in srgb, var(--color-text) 4%, transparent); border: 1px solid var(--color-border); border-radius: 1rem; padding: clamp(1.25rem, 4vw, 2rem); margin-block: 2rem 3rem; }
  .notices h2 { margin-top: 0; }
  .notices ul { padding-left: 1.25rem; margin-bottom: 0; }
  .notices li { margin-block: .6rem; }
  .category-links { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 2rem; }
  .category-links a { display: inline-flex; align-items: center; min-height: 44px; padding: .5rem 1rem; border: 1px solid var(--color-border); border-radius: 999px; font-size: .9rem; color: inherit; text-decoration: none; }
  .category-links a:hover { background: color-mix(in srgb, var(--color-text) 7%, transparent); }
  .contact { border-top: 1px solid var(--color-border); margin-top: 1rem; padding-top: 4rem; text-align: center; }
  .contact h2 { font-size: clamp(1.5rem, 4vw, 2rem); letter-spacing: -.035em; }
  .contact p:not(.eyebrow) { color: var(--color-muted); line-height: 1.8; }
  .contact a { display: inline-flex; align-items: center; min-height: 44px; color: inherit; margin-top: .5rem; text-underline-offset: .25em; overflow-wrap: anywhere; }
</style>
