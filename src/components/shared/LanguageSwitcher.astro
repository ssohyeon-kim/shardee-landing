---
import { locales, names, localizedPath, t, type Locale, type Page } from '../../i18n';
interface Props { locale: Locale; page: Page }
const { locale, page } = Astro.props;
---
<details class="language-switcher">
  <summary aria-label={`${t(locale).nav.language}: ${names[locale]}`}><span aria-hidden="true">◎</span> {names[locale]} <span aria-hidden="true">⌄</span></summary>
  <nav aria-label={t(locale).nav.language}>
    {locales.map(language => <a href={localizedPath(language, page)} hreflang={language} lang={language} data-language={language} aria-current={language === locale ? 'true' : undefined}>{names[language]}{language === locale && <span aria-hidden="true">✓</span>}</a>)}
  </nav>
</details>
<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-language]').forEach(link => {
    link.addEventListener('click', () => {
      try { localStorage.setItem('shardee-locale', link.dataset.language!); } catch {}
    });
  });
</script>
<style>
  .language-switcher { position: relative; flex-shrink: 0; }
  summary { display: flex; align-items: center; justify-content: center; gap: 7px; min-height: 44px; padding: 8px 10px; font-size: 13px; cursor: pointer; list-style: none; white-space: nowrap; border: 1px solid var(--color-border); border-radius: 99px; }
  summary::-webkit-details-marker { display: none; }
  nav { position: absolute; right: 0; top: calc(100% + 10px); width: 180px; padding: 8px; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; box-shadow: 0 12px 36px #0005; z-index: 30; }
  a { min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 12px; border-radius: 6px; text-decoration: none; font-size: 14px; }
  a:hover, a[aria-current] { background: var(--color-border); }
  @media (max-width: 480px) { summary { font-size: 12px; gap: 4px; padding-inline: 8px; } }
</style>
