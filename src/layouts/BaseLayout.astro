---
import '../styles/global.css';
import Seo from '../components/shared/Seo.astro';
import Header from '../components/shared/Header.astro';
import Footer from '../components/shared/Footer.astro';
import LanguageRouting from '../components/shared/LanguageRouting.astro';
import { localeFromPath, pageFromPath, t } from '../i18n';
import { withBase } from '../lib/paths';
import type { Props as SeoProps } from '../components/shared/Seo.astro';
interface Props extends Omit<SeoProps, 'locale' | 'page'> { locale?: SeoProps['locale']; page?: SeoProps['page'] }
const locale = Astro.props.locale || localeFromPath(Astro.url.pathname) || 'ko';
const page = Astro.props.page || pageFromPath(Astro.url.pathname);
const ui = t(locale);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#151618" />
    <Seo {...Astro.props} locale={locale} page={page} />
    <LanguageRouting page={page} />
    <link rel="icon" type="image/png" href={withBase('/brand/favicon.png')} />
    <link rel="apple-touch-icon" href={withBase('/brand/apple-touch-icon.png')} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.nav.skip}</a>
    <Header locale={locale} page={page} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
