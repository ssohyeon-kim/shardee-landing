---
import FaqPage from '../../components/pages/FaqPage.astro';
import LegalPage from '../../components/pages/LegalPage.astro';
import ErrorPage from '../../components/pages/ErrorPage.astro';
import { locales, type Locale } from '../../i18n';
export const getStaticPaths = () => locales.flatMap(locale => ['faq','privacy','terms','404'].map(page => ({ params: { locale, page }, props: { locale, page } })));
interface Props { locale: Locale; page: 'faq' | 'privacy' | 'terms' | '404' }
const { locale, page } = Astro.props;
---
{page === 'faq' ? <FaqPage locale={locale} /> : page === '404' ? <ErrorPage locale={locale} /> : <LegalPage locale={locale} page={page} />}
