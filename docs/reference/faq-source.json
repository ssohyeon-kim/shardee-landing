    },
    "01jfbrnpdjgkx13gkd57hs09p8": {
      "id": "01jfbrnpdjgkx13gkd57hs09p8",
      "type": "list",
      "value": {
        "align": "left",
        "tokens": [
          {
            "text": "We recommend using videos taken with Shardee for the clip-merging feature. If you merge videos recorded with other cameras, some clips may fail to load, or errors could occur."
          }
        ],
        "listStyle": "bullet"
      },
      "parentBlockId": "_root_",
      "sortKey": ".n5ux",
      "rv": 9,
      "rt": 3,
      "version": 1
    },
    "01jfbrnv9kjw892ab7jwyg1dg6": {
      "id": "01jfbrnv9kjw892ab7jwyg1dg6",
      "type": "list",
      "value": {
        "align": "left",
        "tokens": [
          {
            "text": "There are no time or clip number limits for the clip-merging feature. However, selecting excessively long video durations or too many clips may cause the app to crash."
          }
        ]
      },
      "parentBlockId": "_root_",
      "sortKey": ".n5uz",
      "rv": 1,
      "rt": 3,
