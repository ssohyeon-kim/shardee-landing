      "version": 1
    },
    "01jfaa8z6qc0kx389w2z7mbdkj": {
      "id": "01jfaa8z6qc0kx389w2z7mbdkj",
      "type": "list",
      "value": {
        "align": "left",
        "tokens": [
          {
            "text": "클립 합치기 기능은 샤디 찍은 영상을 이용하기를 권장합니다. 다른 카메라로 촬영된 영상을 합치는 경우 일부 불러오지 못하거나 오류가 발생할 수 있습니다. "
          }
        ],
        "listStyle": "bullet"
      },
      "parentBlockId": "_root_",
      "sortKey": ".n5u9",
      "rv": 179,
      "rt": 3,
      "version": 1
    },
    "01jfaacjtgcyfx05qr96v6fy01": {
      "id": "01jfaacjtgcyfx05qr96v6fy01",
      "type": "list",
      "value": {
        "align": "left",
        "tokens": [
          {
            "text": "클립을 합치는 기능에 시간과 클립 수에 제한은 없으나 너무 긴 영상길이 혹은 많은 클립 갯수를 선택한 경우 앱이 강제 종료될 수 있습니다."
          }
        ]
      },
      "parentBlockId": "_root_",
      "sortKey": ".n5ue",
      "rv": 128,
      "rt": 3,
      "version": 1
    },
    "01jfbrmaf7fk0zbyhp4wpeq29q": {
      "id": "01jfbrmaf7fk0zbyhp4wpeq29q",
