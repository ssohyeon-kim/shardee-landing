{
  "name": "shardee-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.14.1",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build && node scripts/prepare-worker.mjs && node scripts/verify-build.mjs",
    "build:production": "node scripts/require-site-url.mjs && npm run build",
    "preview": "npm run preview:worker",
    "preview:worker": "wrangler dev --local --ip 127.0.0.1",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "test:worker": "node scripts/verify-worker.mjs",
    "test": "node --test tests/smoke/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.6",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "wrangler": "4.155.0"
  }
}
